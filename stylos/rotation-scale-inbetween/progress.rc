#pragma code_page(65001)
#include <windows.h>

1 DIALOG 0,0,176,83
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "中割对位"
FONT 9,"Microsoft YaHei UI"
BEGIN
    DEFPUSHBUTTON "1/2",110,7,7,43,20
    PUSHBUTTON "2/3",111,54,7,43,20
    PUSHBUTTON "1/3",112,101,7,43,20
    PUSHBUTTON "▼",113,148,7,21,20
    COMBOBOX 114,7,38,110,96,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "应用",115,122,37,47,16
    PUSHBUTTON "四点自动对位…",116,7,59,162,16
END

2 DIALOG 0,0,226,215
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "中割对位设置"
FONT 9,"Microsoft YaHei UI"
BEGIN
    GROUPBOX "已注册的中割比",-1,7,5,212,109
    LISTBOX 200,15,19,105,86,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    EDITTEXT 201,127,19,82,15,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "添加",202,127,39,39,15
    PUSHBUTTON "更改",203,170,39,39,15
    PUSHBUTTON "删除",204,127,58,39,15
    PUSHBUTTON "恢复默认",205,127,88,82,15
    AUTOCHECKBOX "直接执行 1/2，不显示比例窗口",206,10,120,205,13,WS_TABSTOP
    AUTOCHECKBOX "锁定两张参考图的精确倍率比",207,10,137,205,13,WS_TABSTOP
    AUTOCHECKBOX "每次对位前点选四个特征点",208,10,154,205,13,WS_TABSTOP
    AUTOCHECKBOX "四点对位后跳过预览",209,10,171,205,13,WS_TABSTOP
    DEFPUSHBUTTON "确定",IDOK,113,193,50,16
    PUSHBUTTON "取消",IDCANCEL,169,193,50,16
END

3 DIALOG 0,0,174,48
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "四点自动对位"
FONT 9,"Microsoft YaHei UI"
BEGIN
    LTEXT "起始原画：请点第一个特征",300,7,6,161,14
    PUSHBUTTON "上一步",301,7,26,48,15,BS_NOTIFY
    PUSHBUTTON "移动提示窗",302,59,26,58,15,BS_NOTIFY
