4 DIALOG 0,0,204,108
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "对位预览"
FONT 9,"Microsoft YaHei UI"
BEGIN
    GROUPBOX "透光台图层",-1,5,3,194,48
    LISTBOX 401,11,14,181,31,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_TABSTOP
    LTEXT "拖动红点实时对位。浅红为对应原点，实红为对位结果。",300,8,55,188,25
